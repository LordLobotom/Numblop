# Godot 4+ specific ignores
.godot/
.nomedia
build/
# Anchored: only the Gradle build template at the repository root. An unanchored "android/"
# also swallowed ui/branding/android/, so the launcher icons never reached the repository.
/android/
artifacts/
input/
.tmp_*/

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp
*.log
*.keystore
*.jks
*.p12
*.pfx
*.mobileprovision
# Keystore passwords belong next to the keystore, outside the repo; this is a backstop.
*.pwd

# Exported application artifacts
*.apk
*.aab
*.ipa
*.pck
*.wasm

# Local environment and editor files
.claude/*
!.claude/agents/
.env
.env.*
!.env.example
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json
