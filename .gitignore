# Godot 4+ specific ignores
.godot/
.nomedia
build/
# Anchored: only the Gradle build template Godot regenerates at the repo root.
# Unanchored it also swallowed ui/branding/android/, keeping the launcher icons
# out of git and breaking Android exports from a fresh checkout.
/android/
artifacts/
input/
.tmp_*/

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp
*.log
*.keystore
*.jks
*.p12
*.pfx
*.mobileprovision
# Keystore passwords belong next to the keystore, outside the repo; this is a backstop.
*.pwd

# Exported application artifacts
*.apk
*.aab
*.ipa
*.pck
*.wasm

# Local environment and editor files
.claude/*
!.claude/agents/
.env
.env.*
!.env.example
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json
