; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Numblop"
config/version="0.3.1"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.329412, 0.34902, 0.298039, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://ui/branding/boot_splash.png"
config/icon="res://ui/branding/numblop_ico.png"

[autoload]

EventBus="*res://scripts/autoload/EventBus.gd"
SettingsManager="*res://scripts/autoload/SettingsManager.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
AppState="*res://scripts/autoload/AppState.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=450
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

; Lets a ScrollContainer claim a touch drag that started on a child which consumes
; input (map islands, trophy cards, settings sliders, cosmetic swatches). At the
; default 0 the child keeps the gesture and the screen refuses to scroll.
common/default_scroll_deadzone=12

[internationalization]

locale/translations=PackedStringArray("res://localization/strings.en.translation", "res://localization/strings.cs.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
