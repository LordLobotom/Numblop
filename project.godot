; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Numblop"
config/version="0.4.7"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.329412, 0.34902, 0.298039, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://ui/branding/boot_splash.png"
config/icon="res://ui/branding/numblop_ico.png"

[autoload]

EventBus="*res://scripts/autoload/EventBus.gd"
SettingsManager="*res://scripts/autoload/SettingsManager.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
AppState="*res://scripts/autoload/AppState.gd"
GodotPlayGameServices="*uid://dy0lmup53m18t"
PlayGames="*res://scripts/autoload/PlayGames.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=450
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotPlayGameServices/plugin.cfg")

[gui]

common/default_scroll_deadzone=12

[internationalization]

locale/translations=PackedStringArray("res://localization/strings.en.translation", "res://localization/strings.cs.translation", "res://localization/strings.sk.translation", "res://localization/strings.de.translation", "res://localization/strings.es.translation", "res://localization/strings.fi.translation", "res://localization/strings.fr.translation", "res://localization/strings.nb.translation", "res://localization/strings.pl.translation", "res://localization/strings.sv.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
